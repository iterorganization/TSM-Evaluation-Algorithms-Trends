#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

PROJECT_NAME           = "Piecewise Estimation Algorithm"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Data fusion estimation and reconstruction methods for tokamak systems"
PROJECT_LOGO           = 

FULL_PATH_NAMES        = NO
# Using the top-level README as the main page
USE_MARKDOWN_FILE_AS_MAINPAGE = ../README.md

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

INPUT                  = ../README.md \
                         ../src/c++/piecewise_estimator_lib.hpp \
                         ../src/c++/piecewise_estimator_api.cpp \
#                         ../../README.md \
#                         ../verification/README.md 

INPUT_ENCODING         = UTF-8

# File patterns to document
FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.md

# Exclude patterns
EXCLUDE_PATTERNS       = */test/* \
                         */target/*

#---------------------------------------------------------------------------
# Configuration options related to source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Configuration options related to the alphabetical class index
